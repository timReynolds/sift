{
  "name": "sift-review",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Durable multi-agent GitHub code review",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "sift": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@google-cloud/storage": "8.2.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@octokit/rest": "22.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
